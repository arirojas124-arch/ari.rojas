{
  "name": "erp-multigestion",
  "private": true,
  "version": "0.1.0",
  "description": "ERP modular y multiempresa para web y móvil",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run dev --workspace @erp/api",
    "build:api": "npm run build --workspace @erp/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.5.2"
}
