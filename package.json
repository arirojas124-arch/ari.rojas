{
  "name": "erp-multigestion",
  "private": true,
  "version": "0.1.0",
  "description": "ERP modular y multiempresa para web y móvil",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @erp/api",
    "dev:web": "npm run dev --workspace @erp/web -- --host 0.0.0.0",
    "build": "npm run build --workspace @erp/api && npm run build --workspace @erp/web",
    "build:api": "npm run build --workspace @erp/api",
    "start": "npm run dev",
    "start:api": "npm run start --workspace @erp/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
