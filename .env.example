# API
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006

# MongoDB Atlas: reemplazar solo en el archivo local .env
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>/<base_de_datos>?retryWrites=true&w=majority

# Auth: generar valores locales fuertes; no versionar secretos reales
JWT_ACCESS_SECRET=replace-with-a-long-random-local-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-local-secret
JWT_ACCESS_EXPIRES_IN=15m
MONGODB_CONNECT_TIMEOUT_MS=5000
